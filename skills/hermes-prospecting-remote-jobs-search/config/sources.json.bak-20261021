{
  "sources": {
    "remoteok": {
      "adapter": "remoteok",
      "url": "https://remoteok.com/api",
      "enabled": true,
      "kind": "json_api",
      "notes": "Fresh, fast-moving board with salary fields. Links back to remoteok.com job page; some postings expose a direct apply URL in extra.apply_url_hint."
    },
    "remotive": {
      "adapter": "remotive",
      "url": "https://remotive.com/api/remote-jobs?limit=100",
      "enabled": true,
      "kind": "json_api",
      "notes": "Salary and candidate_required_location present. Search via &search=<term>."
    },
    "jobicy": {
      "adapter": "jobicy",
      "url": "https://jobicy.com/api/v2/remote-jobs?count=50",
      "enabled": false,
      "kind": "json_api",
      "notes": "EXCLUDED BY VINNY, Oct 18 2026: every jobicy job page demanded an account signup and data collection before the employer form, and he will not spend 30-60 minutes creating accounts to collect spam. Do not re-enable this source. Kept only so the adapter is not silently reused."
    },
    "himalayas": {
      "adapter": "himalayas",
      "url": "https://himalayas.app/jobs/api?limit=100",
      "enabled": true,
      "kind": "json_api",
      "notes": "Richest pay data (minSalary/maxSalary/salaryPeriod) plus locationRestrictions for US eligibility."
    },
    "wwr": {
      "adapter": "wwr",
      "url": "https://weworkremotely.com/remote-jobs.rss",
      "enabled": true,
      "kind": "rss",
      "feeds": [
        "https://weworkremotely.com/remote-jobs.rss"
      ],
      "notes": "Only the root feed is enabled. Category feeds return 403 and parse errors, and Vinny put them on the dead list on October 18, 2026, so do not spend research time on them. WWR also account-walls most listings, so only postings whose feed body carries the employer link survive verification."
    },
    "workingnomads": {
      "adapter": "workingnomads",
      "url": "https://www.workingnomads.com/api/exposed_jobs/",
      "enabled": true,
      "kind": "json_api",
      "notes": "Free exposed_jobs feed with company_name, tags, location, pub_date. No pay field, so pay has to be found elsewhere or flagged."
    },
    "arbeitnow": {
      "adapter": "arbeitnow",
      "url": "https://arbeitnow.com/api/job-board-api",
      "enabled": true,
      "kind": "json_api",
      "notes": "Europe-weighted but carries a remote flag and job_types. Low yield for US-remote roles, cheap to include."
    },
    "nodesk": {
      "adapter": "nodesk",
      "url": "https://nodesk.co/remote-jobs/index.xml",
      "enabled": true,
      "kind": "rss",
      "notes": "Curated remote list, low volume, decent pay disclosure."
    },
    "jobspresso": {
      "adapter": "jobspresso",
      "url": "https://jobspresso.co/remote-work-jobs/feed/",
      "enabled": true,
      "kind": "rss",
      "notes": "Low volume, occasionally good writing and marketing roles."
    },
    "hnrss_jobs": {
      "adapter": "hnrss_jobs",
      "url": "https://hnrss.org/jobs",
      "enabled": true,
      "kind": "rss",
      "notes": "Recent HN job feed."
    },
    "whoishiring": {
      "adapter": "whoishiring",
      "url": "https://hn.algolia.com/api/v1/search_by_date?query=who+is+hiring&tags=story",
      "enabled": true,
      "kind": "json_api",
      "notes": "Latest Ask HN: Who is hiring thread comments. High contract and freelance density, often founder-direct with an email to apply. Thread is monthly, so freshness must be checked against the comment text, not the thread."
    },
    "ats": {
      "adapter": "ats",
      "url": "",
      "enabled": true,
      "kind": "json_api",
      "notes": "Employer ATS boards from config/companies.json (Greenhouse, Ashby, Lever). Every posting carries the employer's own application URL, which is the only apply path Vinny will accept. Remote rows only, capped per employer by params.ats_per_company."
    }
  }
}